// use prisma-8

model Post{
  id  Int @id @default(autoincrement())
  title String  @unique 
  content String
  author String @default("admin")
  categoryId Int
  category Category @relation(fields: [categoryId], references: [id])
}

model Category{
  id Int @id @default(autoincrement())
  name String  @unique
  posts Post[]
}
